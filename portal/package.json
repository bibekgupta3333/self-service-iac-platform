    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
