{
  "name": "iacp-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Developer portal for the Self-Service IaC Platform",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings=0 .",
