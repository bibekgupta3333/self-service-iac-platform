# METADATA
# title: Required iacp tags
# description: |
#   Every taggable resource being created or updated must carry the four
#   platform tags with non-empty values, and the ownership tags must match
#   the stack context when one is supplied.
package iacp.tags

import data.lib.iacp as f

required := {"iacp:team", "iacp:environment", "iacp:stack", "iacp:managed-by"}

# present_tags(rc): required tag keys that are set to a non-empty string.
present_tags(rc) := {k |
	some k, v in f.tags_of(rc)
	k in required
	is_string(v)
	v != ""
}

missing(rc) := required - present_tags(rc)

deny contains m if {
	some rc in f.changed
	f.taggable(rc)
	count(missing(rc)) > 0
	not f.exempt("iacp.tags.required", rc.address)
	m := f.msg(
		"iacp.tags.required", rc.address,
		sprintf("missing or empty tags %v", [sort(missing(rc))]),
		"set them via the provider default_tags block or the module's tags input",
	)
}

# Ownership tags must match the stack context (team, environment, stack).
context_tag := {"iacp:team": "team", "iacp:environment": "environment", "iacp:stack": "stack"}

deny contains m if {
	some rc in f.changed
	some tag, key in context_tag
	expected := f.ctx[key]
	actual := f.tags_of(rc)[tag]
	actual != expected
	m := f.msg(
		"iacp.tags.mismatch", rc.address,
		sprintf("tag %s=%q does not match the stack's %s %q", [tag, actual, key, expected]),
		sprintf("set %s to %q (tags are generated by the platform; do not override them)", [tag, expected]),
	)
}
